import java.util.*;
import java.lang.*;
import java.io.*;

class Codechef
{
	public static void main (String[] args) throws java.lang.Exception
	{
	    Scanner sc = new Scanner(System.in);
	    int t = sc.nextInt();
	    for (int i=0; i<t; i++){
	        int x,y,z;
	        x = sc.nextInt();
	        y = sc.nextInt();
	        z = sc.nextInt();
	        int totalStudents = x*y;
	        if(totalStudents/2 < z){
	            System.out.println("YES");
	        }
	        else{
	            System.out.println("NO");
	        }
	    } 
	    sc.close();
	}
}
